# ---- credentials & local config (NEVER commit) ----
CONNECTION_CONFIG.md
QuorumMetadataMCP/dbconfig.json
.claude/settings.local.json
*.env

# ---- large binaries (team copies these separately — see docs/TEAM_SETUP.md) ----
QuorumMetadataMCP/*.exe
QuorumMetadataMCP/*.pdb
