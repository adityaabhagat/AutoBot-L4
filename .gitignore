products/*/code_cache/

# ---- generated indexes (rebuild: python engine/kb.py build --all) ----
products/*/kb_index/

# ---- live case workspaces (work product, not shared code) ----
cases/*
!cases/README.md

# ---- python ----
__pycache__/
*.pyc
.venv/
.pytest_cache/
